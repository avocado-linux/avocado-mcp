{
  "name": "avocado-os-mcp-server",
  "version": "4.0.0",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "avocado-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepublishOnly": "npm run build",
    "dev": "npm run build && node build/index.js",
    "test": "npm run build && npx @modelcontextprotocol/inspector build/index.js",
    "inspect": "@modelcontextprotocol/inspector build/index.js",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "checks": "npm run format:check && npm run typecheck"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "avocado",
    "embedded",
    "yocto",
    "linux",
    "os",
    "rpm"
  ],
  "author": "Avocado Linux",
  "license": "ISC",
  "description": "MCP server for Avocado OS configuration with essential tools: get-config-schema (required for validation) and query-repos (package searches during configuration generation)",
  "repository": {
    "type": "git",
    "url": "https://github.com/avocado-linux/avocado-mcp.git"
  },
  "homepage": "https://github.com/avocado-linux/avocado-mcp#readme",
  "bugs": {
    "url": "https://github.com/avocado-linux/avocado-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.15.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.0",
    "@types/xml2js": "^0.4.14",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "better-sqlite3": "^9.2.2",
    "bzip2": "^0.1.1",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  }
}
