{
  "mcp.servers": {
    "avocado-os": {
      "command": "node",
      "args": ["./build/index.js"],
      "cwd": "${workspaceFolder}",
      "env": {
        "AVOCADO_SDK_REPO_URL": "https://github.com/avocado-linux/sdk",
        "AVOCADO_SDK_REPO_RELEASE": "latest"
      }
    }
  },
  "mcp.enabled": true,
  "typescript.preferences.useAliasesForRenames": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  }
}
